{
  "name": "@nayan9229/ads",
  "version": "1.2.2",
  "description": "Prebid.js wrapper SDK — self-executing script tag, batched auction, banner / outstream / native.",
  "type": "module",
  "main": "dist/pubads.mini.js",
  "module": "dist/pubads.mini.esm.js",
  "exports": {
    ".": {
      "import": "./dist/pubads.mini.esm.js",
      "default": "./dist/pubads.mini.js"
    },
    "./dist/pubads.mini.js": "./dist/pubads.mini.js",
    "./dist/pubads.mini.esm.js": "./dist/pubads.mini.esm.js"
  },
  "files": [
    "dist/pubads.mini.js",
    "dist/pubads.mini.js.map",
    "dist/pubads.mini.esm.js",
    "dist/pubads.mini.esm.js.map",
    "dist/sri.txt",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nayan9229/ads.git"
  },
  "homepage": "https://github.com/nayan9229/ads#readme",
  "bugs": {
    "url": "https://github.com/nayan9229/ads/issues"
  },
  "keywords": [
    "prebid",
    "header-bidding",
    "ad-tech",
    "rtb",
    "openrtb",
    "ima",
    "video-ads"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "build": "rollup -c && npm run inline-prebid",
    "inline-prebid": "node scripts/inline-prebid.mjs",
    "size": "node scripts/check-bundle-size.mjs",
    "sri": "node scripts/compute-sri.mjs",
    "parse-bench": "node scripts/parse-bench.mjs",
    "build:check": "npm run build && npm run size && npm run sri",
    "e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.7.5",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.3.0",
    "gzip-size": "^7.0.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.8.3",
    "rollup": "^4.60.3",
    "semantic-release": "^24.2.9",
    "ts-jest": "^29.2.5",
    "tslib": "^2.8.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.59.3"
  },
  "engines": {
    "node": ">=20"
